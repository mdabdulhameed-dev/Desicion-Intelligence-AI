# Stratagem AI Backend (Server) Environment Variables
PORT=5000
NODE_ENV=development
JWT_SECRET=stratagem-decision-intelligence-jwt-secret-2025-secure-key
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Supabase PostgreSQL & Auth Configuration
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

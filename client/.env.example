# Stratagem AI Frontend (Client) Environment Variables
# Target backend API base URL
VITE_API_BASE_URL=/api

# Optional: Supabase Client Direct Credentials (if using Supabase Auth/Storage directly on frontend)
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
